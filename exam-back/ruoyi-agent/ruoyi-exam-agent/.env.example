# ==========================================================
# ruoyi-exam-agent 配置模板（复制为 .env 后按需修改）
# ==========================================================

# ---------------- L5 接入层 ----------------
AGENT_HOST=0.0.0.0
AGENT_PORT=9221
AGENT_DEBUG=false
AGENT_SERVICE_NAME=ruoyi-exam-agent

# Nacos（开启鉴权时必须填用户名密码）
AGENT_NACOS_ENABLED=true
AGENT_NACOS_SERVER=127.0.0.1:8848
AGENT_NACOS_NAMESPACE=dev
AGENT_NACOS_GROUP=DEFAULT_GROUP
AGENT_NACOS_USERNAME=nacos
AGENT_NACOS_PASSWORD=nacos
AGENT_NACOS_HEARTBEAT_INTERVAL=5
# 注册用的 IP。留空则自动探测出口网卡地址；
# 多网卡 / Docker / 端口映射必须显式指定，否则别的服务拿到的是不可达地址
# AGENT_NACOS_IP=172.20.10.2

# ---------------- L2 模型网关 ----------------
# 配置源按顺序尝试：mysql 读不到就降级到 env
AGENT_MODEL_SOURCE=mysql,env
AGENT_MODEL_CACHE_TTL=60
AGENT_MODEL_FAILOVER_ENABLED=true
AGENT_MODEL_MAX_RETRY=1
AGENT_MODEL_FUSE_THRESHOLD=3
AGENT_MODEL_FUSE_COOLDOWN=60
AGENT_MODEL_DEFAULT_TIMEOUT=60

# MySQL：只读 ry-cloud.ai_model_config，严禁写入
AGENT_MYSQL_ENABLED=true
AGENT_MYSQL_HOST=127.0.0.1
AGENT_MYSQL_PORT=3306
AGENT_MYSQL_USER=root
AGENT_MYSQL_PASSWORD=
AGENT_MYSQL_DATABASE=ry-cloud

# ---------------- L1 模型供应商（env 兜底源）----------------
# 自测开关：不配真实 Key 时也能跑通链路，返回空结构。严禁生产使用。
AGENT_LLM_MOCK=false
AGENT_LLM_PROVIDER=openai
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-chat
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_MAX_TOKENS=2048
AGENT_LLM_TIMEOUT=60

# 多模型主备（JSON 数组字符串，priority 小者优先）
# AGENT_LLM_MODELS=[{"name":"DeepSeek","model_name":"deepseek-chat","base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx","priority":10},{"name":"Qwen","model_name":"qwen-plus","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key":"sk-yyy","priority":20}]

# ---------------- L3 工具层（回调 Java 网关）----------------
AGENT_TOOLS_ENABLED=true
AGENT_JAVA_GATEWAY_BASE_URL=http://127.0.0.1:9220
AGENT_JAVA_GATEWAY_TOKEN=
AGENT_JAVA_GATEWAY_TIMEOUT=10

# ---------------- L3 记忆层 ----------------
# auto = 优先 Redis，连不上自动降级为内存
AGENT_MEMORY_BACKEND=auto
AGENT_MEMORY_TTL=1800
AGENT_REDIS_HOST=127.0.0.1
AGENT_REDIS_PORT=6379
AGENT_REDIS_PASSWORD=
AGENT_REDIS_DB=0

# ---------------- L3 RAG ----------------
AGENT_RAG_ENABLED=false
AGENT_RAG_TOP_K=4
AGENT_RAG_VECTOR_STORE=chroma
AGENT_RAG_EMBEDDING_MODEL=bge-m3

# ---------------- L4 编排层 ----------------
AGENT_AGENT_MAX_STEPS=12
AGENT_AGENT_MAX_PARALLEL=4
AGENT_AGENT_REFLECTION_ENABLED=true
AGENT_AGENT_REFLECTION_MIN_SCORE=0.6

# ---------------- 观测 ----------------
AGENT_LOG_LEVEL=INFO
AGENT_CALL_LOG_ENABLED=true
AGENT_CALL_LOG_SIZE=500
